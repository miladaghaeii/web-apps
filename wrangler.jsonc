{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2c9301bb-4b7a-45af-93a4-8d4c8218bcaf","database_name": "web-apps" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a04e0ee2d7114a9b81945db4ce3451d4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
